    <!--
      name-parser 5.0.0 dropped the pure-Java implementation; org.gbif.nameparser:name-parser-rust
      is the only NameParser now. It downcalls a Rust cdylib over FFM (java.lang.foreign), which is
      why JDK 22+ (we are on 25) and the enable-native-access opt-in are required at runtime.

      The artifact is a thin classes-only JAR plus one classifier JAR per platform carrying that
      platform's cdylib under native/<os.detected.classifier>/. Ffi picks the directory from
      os.name/os.arch at *runtime*, so bundling several is fine and only the matching one is loaded.
      We hard-wire both linux classifiers because JenkinsfileDocker builds a single -exec.jar on the
      x86_64 build agent and ships it in both the linux/amd64 and the linux/arm64 image; resolving
      only ${os.detected.classifier} would leave the arm64 image without a cdylib.
    -->
    <dependency>
      <groupId>org.gbif.nameparser</groupId>
      <artifactId>name-parser-rust</artifactId>
    </dependency>
    <dependency>
      <groupId>org.gbif.nameparser</groupId>
      <artifactId>name-parser-rust</artifactId>
      <version>${name-parser-rust.version}</version>
      <classifier>linux-x86_64</classifier>
    </dependency>
    <dependency>
      <groupId>org.gbif.nameparser</groupId>
      <artifactId>name-parser-rust</artifactId>
      <version>${name-parser-rust.version}</version>
      <classifier>linux-aarch_64</classifier>
    </dependency>
