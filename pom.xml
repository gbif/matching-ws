  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.7.0</version>
      </plugin>
      <!--
        Tests parse names, which downcalls into the rust parser's cdylib over FFM. Without the
        opt-in every forked JVM warns about the restricted java.lang.foreign call, and a later JDK
        will refuse it outright. ${java.argLine} is the motherpom's list, kept by reference.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${java.argLine} --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>${java.argLine} --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration combine.self="override">
          <formats>
            <format>
              <includes>
                <include>src/**/*.java</include>
              </includes>
              <excludes>
                <exclude>src/**/SciNameNormalizer.java</exclude>
              </excludes>
            </format>
          </formats>
          <java>
            <removeUnusedImports />
            <googleJavaFormat>
              <version>1.17.0</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- Runs in compile phase to fail fast in case of formatting issues.-->
            <id>spotless-check</id>
            <phase>compile</phase>
            <goals>
              <goal>check</goal>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <id>repackage</id>
            <phase>package</phase>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <mainClass>life.catalogue.matching.Main</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The two linux cdylibs above cover everything we deploy. Developers build and test on macOS,
      so add that host's classifier JAR too - ${os.detected.classifier} comes from the os-maven-plugin
      build extension inherited from the motherpom. Guarded by a profile rather than declared
      unconditionally because on linux it would resolve to a duplicate of one of the two above,
      which Maven rejects as a non-unique dependency key.
    -->
    <profile>
      <id>native-parser-macos</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.gbif.nameparser</groupId>
          <artifactId>name-parser-rust</artifactId>
          <classifier>${os.detected.classifier}</classifier>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
